{
  "name": "@workspace/scheduler",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "dev:scheduled": "wrangler dev --test-scheduled --port 8787",
    "deploy": "wrangler deploy",
    "deploy:dev": "wrangler deploy --config wrangler.dev.toml",
    "logs": "wrangler tail",
    "logs:dev": "wrangler tail --config wrangler.dev.toml",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "wrangler": "^3.99.0"
  }
}
